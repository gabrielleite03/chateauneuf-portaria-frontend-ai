[Unit]
Description=Chateauneuf authentication with LAN readiness and retry
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/chateauneuf/operations/auth-network-guard.py
ExecStop=/usr/bin/docker stop --time 20 network-auth-service
Restart=always
RestartSec=10
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
