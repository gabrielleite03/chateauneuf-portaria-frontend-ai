# Images publicadas no DockerHub.
# Use tag fixa para garantir que a estacao instalou exatamente a versao esperada.
FRONTEND_IMAGE=gabrielleite03/chateauneuf-portaria-frontend:2026.09.22.1
AUTH_IMAGE=gabrielleite03/chateauneuf-auth:2026.09.03.3
BACKEND_IMAGE=gabrielleite03/chateauneuf-portaria-backend:2026.09.22.1
STREAM_IMAGE=gabrielleite03/chateauneuf-stream:2026.09.02.5
FRONTEND_APP_VERSION=2026.09.22.1
BACKEND_APP_VERSION=2026.09.22.1

# Portas expostas na estacao.
FRONTEND_PORT=8081
FRONTEND_HTTPS_PORT=8443
BACKEND_PORT=18080
STREAM_PORT=18082
AUTH_HTTP_PORT=80
AUTH_PORT=8080

# Equipamento de videoporteiro usado pelo servico de stream.
VD5116_HOST=192.168.10.101
VD5116_PORT=7625
VD5116_HTTP_PORT=7625
VD5116_RTSP_PORT=7618
VD5116_USERNAME=admin
VD5116_PASSWORD=SUBSTITUA_PELA_SENHA_DO_VD5116
VD5116_RTSP_URL=rtsp://admin:SUBSTITUA_PELA_SENHA_DO_VD5116@192.168.10.101:7618/cam/realmonitor?channel=1&subtype=0

# Google Sheets.
GOOGLE_SHEET_ID=10AqRHD9k925C51msbKEzOiXkCTKtzW9A4mi1nNqpoG8
GOOGLE_SHEET_NAME=Entradas
GOOGLE_DRIVE_FOLDER_ID=
SYNC_INTERVAL_SECONDS=30

# Pasta local para o banco SQLite usado pelo backend Docker.
LOCAL_DATA_DIR=./data
LOCAL_AUTH_DATA_DIR=./auth-data

# Integracao de autenticacao. Gere AUTH_ADMIN_TOKEN com pelo menos 32 bytes.
AUTH_ADMIN_TOKEN=SUBSTITUA_POR_TOKEN_LONGO_E_ALEATORIO
INTERNAL_API_TOKEN=SUBSTITUA_POR_OUTRO_TOKEN_LONGO_E_ALEATORIO
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_BCC=
EMPLOYEE_ENROLLMENT_PASSWORD=
CLIENT_AUTH_DURATION=2160h
EMPLOYEE_AUTH_DURATION=720h
OMADA_MOCK=false
OMADA_BASE_URL=https://192.168.10.100:8043
OMADA_USERNAME=
OMADA_PASSWORD=
OMADA_SITE=Chateauneuf
OMADA_CONTROLLER_ID=
OMADA_TLS_INSECURE=true
OMADA_REVOCATION_PATH=
OMADA_OPENAPI_CLIENT_ID=
OMADA_OPENAPI_CLIENT_SECRET=
OMADA_OPENAPI_OMADAC_ID=
OMADA_SITE_ID=

# Pasta local sincronizada pelo Google Drive para computador.
# Exemplo Windows: C:\Users\AdminUser\Google Drive\Meu Drive\Fotos Portaria
LOCAL_PHOTO_DIR=./photos

# Certificados locais usados pelo frontend HTTPS.
LOCAL_CERT_DIR=./certs

# Origem permitida para chamadas diretas ao backend.
ALLOWED_ORIGIN=http://localhost:8081
